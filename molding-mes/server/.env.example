# 复制为 .env 后按需修改

NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# 生产环境必须修改：JWT 签名密钥与平台超管口令
JWT_SECRET=change-this-to-a-long-random-string
TOKEN_TTL_HOURS=720
PLATFORM_TOKEN=change-this-platform-token

# 数据库：sqlite（零依赖，本地/单机）或 mysql（生产）
DB_DIALECT=sqlite
# DB_DIALECT=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=mes
# DB_PASSWORD=mes123456
# DB_NAME=molding_mes
# DB_POOL=10

# 排产参数（与专家团口径一致）
SCHEDULE_BUFFER_MINUTES=30
FEEDING_ORDER_LEAD=60
FEEDING_READY_LEAD=30
SHIFT_HOURS=12

# AI 默认配置（每个公司可在后台单独覆盖）
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TEMPERATURE=0.1
AI_TIMEOUT_MS=20000
# 未配置 Key 时允许使用内置确定性解析器
AI_ALLOW_FALLBACK=true

# 是否静态托管管理后台
SERVE_ADMIN_WEB=true
