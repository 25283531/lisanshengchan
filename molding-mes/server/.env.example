# 复制为 .env 后按需修改

NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# 生产环境必须修改：JWT 签名密钥与平台超管口令
JWT_SECRET=change-this-to-a-long-random-string
TOKEN_TTL_HOURS=720
PLATFORM_TOKEN=change-this-platform-token

# 数据库：sqlite（零依赖，本地/单机）或 mysql（生产）
DB_DIALECT=sqlite
# DB_DIALECT=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=mes
# DB_PASSWORD=mes123456
# DB_NAME=molding_mes
# DB_POOL=10

# 排产参数（与专家团口径一致）
SCHEDULE_BUFFER_MINUTES=30
FEEDING_ORDER_LEAD=60
FEEDING_READY_LEAD=30
SHIFT_HOURS=12

# AI 默认配置（每个公司可在后台单独覆盖）
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TEMPERATURE=0.1
AI_TIMEOUT_MS=20000
# 未配置 Key 时允许使用内置确定性解析器
AI_ALLOW_FALLBACK=true

# 是否静态托管管理后台
SERVE_ADMIN_WEB=true

# 排产求解器（v3.1 新增）
# CP-SAT 微服务地址：optimizer/main.py（uvicorn）。
# disabled 时自动降级到内置列表调度（无 OR-Tools 依赖，结果可复现但不保证全局最优）。
OPTIMIZER_ENABLED=true
OPTIMIZER_URL=http://127.0.0.1:8090
OPTIMIZER_TIMEOUT_MS=30000
OPTIMIZER_HORIZON_HOURS=720

# 微信小程序（v3.2 新增）
# 填入现有小程序的凭证后走真实微信鉴权（jscode2session）
# Secret 属于敏感信息，只放本文件，切勿提交到代码仓库
WX_APPID=
WX_SECRET=
# 开发模式：允许用 dev- 前缀的假 code 走本地桩，便于不动真机也能联调。
# 配置为凭证后也不会自动关闭，但 code 必须是 dev- 开头才命中；上线务必置 false
WX_DEV_MODE=true
WX_TIMEOUT_MS=10000
# 绑定方式：
#   auto  —— 优先「管理员生成的绑定码」（任何主体都可用，推荐）
#   phone —— 走手机号快速验证组件 getPhoneNumber
#            注意：该组件仅对已微信认证的非个人主体小程序开放且按次收费，
#            个人主体小程序调不通，请保持 auto
WX_BIND_MODE=auto
